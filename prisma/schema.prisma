generator client {
    provider     = "prisma-client"
    output       = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum DiscDimension {
    D
    I
    S
    C
}

enum FormStatus {
    in_progress
    completed
}

enum OrganizationRole {
    OWNER
    MANAGER
    MEMBER
}

enum InvitationType {
    TEAM_MEMBER
    EXTERNAL
    REFERRAL
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    EXPIRED
    REVOKED
}

model User {
    id            String         @id @default(uuid())
    username      String?
    email         String         @unique
    hash          String?
    googleId      String?        @unique
    created_at    DateTime?      @default(now())
    Form          Form[]
    RefreshToken  RefreshToken[]
    memberships   OrganizationMembership[]
    invitedMemberships OrganizationMembership[] @relation("InvitedBy")
    sentInvitations   Invitation[]
}

model Question {
    id            String         @id @default(uuid())
    content       String
    category      String?
    options       Option[]
    Answer        Answer[]
    formQuestions FormQuestion[]
}

model Option {
    value      String          @unique
    content    String
    dimension  DiscDimension
    Question   Question        @relation(fields: [questionId], references: [id])
    questionId String
    Answer     Answer[]

    @@index([questionId])
}

model RefreshToken {
    id        String   @id @default(cuid())
    tokenHash String
    User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    expiresAt DateTime
    createdAt DateTime @default(now())
    revokedAt DateTime?

    @@index([userId])
}

model Organization {
    id        String                    @id @default(uuid())
    name      String
    createdAt DateTime                  @default(now())
    members   OrganizationMembership[]
    invitations Invitation[]
}

model OrganizationMembership {
    id             String           @id @default(cuid())
    userId         String
    organizationId String
    role           OrganizationRole
    invitedById    String?
    joinedAt       DateTime         @default(now())

    user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    invitedBy    User?             @relation("InvitedBy", fields: [invitedById], references: [id])

    @@unique([userId, organizationId])
    @@index([userId])
    @@index([organizationId])
}

model Invitation {
    id              String           @id @default(uuid())
    email           String
    type            InvitationType
    status          InvitationStatus @default(PENDING)
    token           String           @unique
    organizationId  String?
    invitedByUserId String
    expiresAt       DateTime
    acceptedAt      DateTime?
    formId          String?
    createdAt       DateTime         @default(now())

    organization Organization? @relation(fields: [organizationId], references: [id])
    invitedBy    User          @relation(fields: [invitedByUserId], references: [id])
    form         Form?         @relation(fields: [formId], references: [id])

    @@index([organizationId])
    @@index([invitedByUserId])
    @@index([email])
    @@index([status])
}

model Form {
    id         String         @id @default(uuid())
    name       String         @default("disc_form")
    status     FormStatus     @default(in_progress)
    User       User?          @relation(fields: [user_id], references: [id])
    user_id    String?
    answers    Answer[]
    questions  FormQuestion[]
    invitations Invitation[]
    created_at DateTime?      @default(now())
    updated_at DateTime?

    @@index([user_id])
}

model FormQuestion {
    id         String   @id @default(cuid())
    form       Form     @relation(fields: [formId], references: [id])
    formId     String
    question   Question @relation(fields: [questionId], references: [id])
    questionId String
    order      Int
    answered   Boolean  @default(false)

    @@unique([formId, questionId])
    @@index([questionId])
}

model Answer {
    id          String    @id @default(cuid())
    Option      Option    @relation(fields: [optionValue], references: [value])
    optionValue String
    Question    Question  @relation(fields: [question_id], references: [id])
    question_id String
    Form        Form      @relation(fields: [form_id], references: [id])
    form_id     String
    updated_at  DateTime? @default(now())

    @@unique([form_id, question_id])
    @@index([question_id])
    @@index([optionValue])
    @@index([form_id])
}
