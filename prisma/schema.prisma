generator client {
    provider     = "prisma-client"
    output       = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum DiscDimension {
    D
    I
    S
    C
}

enum FormStatus {
    in_progress
    completed
}

enum OrganizationRole {
    OWNER
    MANAGER
    EMPLOYEE
    CANDIDATE
}

enum InvitationTargetStatus {
    CANDIDATE
    EMPLOYEE
    MANAGER
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    EXPIRED
    REVOKED
}

enum OwnershipTransferStatus {
    PENDING
    ACCEPTED
    CANCELLED
}

model User {
    id            String         @id @default(uuid())
    firstName     String
    lastName      String?
    birthDate     DateTime?
    email         String         @unique
    hash          String?
    googleId      String?        @unique
    created_at    DateTime?      @default(now())
    RefreshToken  RefreshToken[]
    members       OrganizationMember[]
    invitedMembers OrganizationMember[] @relation("MemberInvitedBy")
    sentInvitations Invitation[]
    transfersInitiated OwnershipTransfer[] @relation("TransferFrom")
    transfersReceived  OwnershipTransfer[] @relation("TransferTo")
}

model Question {
    id            String         @id @default(uuid())
    content       String
    category      String?
    options       Option[]
    Answer        Answer[]
    formQuestions FormQuestion[]
}

model Option {
    value      String          @unique
    content    String
    dimension  DiscDimension
    Question   Question        @relation(fields: [questionId], references: [id])
    questionId String
    Answer     Answer[]

    @@index([questionId])
}

model RefreshToken {
    id        String   @id @default(cuid())
    tokenHash String
    User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    expiresAt DateTime
    createdAt DateTime @default(now())
    revokedAt DateTime?

    @@index([userId])
}

model Organization {
    id        String                    @id @default(uuid())
    name      String
    createdAt DateTime                  @default(now())
    members   OrganizationMember[]
    teams     Team[]
    invitations Invitation[]
    ownershipTransfers OwnershipTransfer[]
    formLinks FormOrganization[]
}

model Team {
    id             String   @id @default(uuid())
    organizationId String
    name           String
    createdAt      DateTime @default(now())

    organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    members        OrganizationMember[]
    invitations    Invitation[]

    @@unique([organizationId, name])
    @@index([organizationId])
}

model OrganizationMember {
    id              String           @id @default(uuid())
    organizationId  String
    userId          String?
    email           String
    firstName       String
    lastName        String?
    role            OrganizationRole
    teamId          String?
    invitedById     String?
    joinedAt        DateTime         @default(now())

    organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
    team         Team?             @relation(fields: [teamId], references: [id])
    invitedBy           User?             @relation("MemberInvitedBy", fields: [invitedById], references: [id])
    forms               Form[]
    promotionInvitations Invitation[]     @relation("PromotionInvitation")

    @@unique([organizationId, email])
    @@unique([userId, organizationId])
    @@index([organizationId])
    @@index([teamId])
    @@index([email])
    @@index([userId])
}

model OwnershipTransfer {
    id             String                  @id @default(uuid())
    organizationId String
    fromUserId     String
    toUserId       String
    status         OwnershipTransferStatus @default(PENDING)
    createdAt      DateTime                @default(now())
    acceptedAt     DateTime?

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    fromUser     User         @relation("TransferFrom", fields: [fromUserId], references: [id])
    toUser       User         @relation("TransferTo", fields: [toUserId], references: [id])

    @@unique([organizationId, status])
    @@index([toUserId])
}

model Invitation {
    id              String                  @id @default(uuid())
    email           String
    firstName       String
    lastName        String?
    targetStatus    InvitationTargetStatus
    status          InvitationStatus        @default(PENDING)
    token           String                  @unique
    organizationId  String
    teamId          String?
    invitedByUserId String
    expiresAt       DateTime
    acceptedAt      DateTime?
    formId          String?
    memberId        String?                 @map("member_id")
    createdAt       DateTime                @default(now())

    organization Organization         @relation(fields: [organizationId], references: [id])
    team         Team?                 @relation(fields: [teamId], references: [id])
    invitedBy    User                  @relation(fields: [invitedByUserId], references: [id])
    form         Form?                 @relation(fields: [formId], references: [id])
    member       OrganizationMember?   @relation("PromotionInvitation", fields: [memberId], references: [id], onDelete: SetNull)

    @@index([organizationId])
    @@index([teamId])
    @@index([invitedByUserId])
    @@index([memberId])
    @@index([email])
    @@index([status])
}

model Form {
    id         String         @id @default(uuid())
    name       String         @default("disc_form")
    status     FormStatus     @default(in_progress)
    member     OrganizationMember? @relation(fields: [memberId], references: [id])
    memberId   String?
    answers    Answer[]
    questions  FormQuestion[]
    invitations Invitation[]
    organizations FormOrganization[]
    created_at DateTime?      @default(now())
    updated_at DateTime?

    @@index([memberId])
}

model FormOrganization {
    formId         String
    organizationId String

    form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@unique([formId, organizationId])
    @@index([formId])
    @@index([organizationId])
}

model FormQuestion {
    id         String   @id @default(cuid())
    form       Form     @relation(fields: [formId], references: [id])
    formId     String
    question   Question @relation(fields: [questionId], references: [id])
    questionId String
    order      Int
    answered   Boolean  @default(false)

    @@unique([formId, questionId])
    @@index([questionId])
}

model Answer {
    id          String    @id @default(cuid())
    Option      Option    @relation(fields: [optionValue], references: [value])
    optionValue String
    Question    Question  @relation(fields: [question_id], references: [id])
    question_id String
    Form        Form      @relation(fields: [form_id], references: [id])
    form_id     String
    updated_at  DateTime? @default(now())

    @@unique([form_id, question_id])
    @@index([question_id])
    @@index([optionValue])
    @@index([form_id])
}
